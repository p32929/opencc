#!/bin/sh
# Every commit bumps the patch version in package.json (0.1.67 → 0.1.68), unless the commit already
# changes the version. Turned on in a clone with: git config core.hooksPath .githooks
# (git commit --no-verify skips it.)
exec node "$(git rev-parse --show-toplevel)/.githooks/bump-version.mjs"
