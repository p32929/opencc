# opencc tries providers in order. The first one is unsuffixed; add fallbacks
# with _2, _3, ... and so on. If a provider is rate-limited, out of credits,
# down, or doesn't know the model, opencc moves on to the next one.

# --- Provider 1 (preferred) ---------------------------------------------
# Optional name, used in the menu, the startup banner and the logs.
# Leave it out and the provider is named after its host instead.
PROVIDER_NAME=my openai

# Set to true to park this provider: it keeps its place, key and models but
# is skipped when picking one to call. Omit it (or set anything else) to use
# the provider normally.
# PROVIDER_DISABLED=true


# The OpenAI-compatible API you want Claude Code to actually use.
# Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1,
# http://localhost:11434/v1 (Ollama), etc.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional — leave blank for a backend that needs no key (e.g. local Ollama).
OPENAI_API_KEY=sk-...

# BIG models: these do the real work. This is a
# comma-separated priority list, tried left to right: free tiers throttle per
# model, so when the first starts returning 429s the next often still works.
# opencc exhausts this list before moving to the next provider.
BIG_MODEL=gpt-4o, gpt-4o-2024-08-06

# SMALL models: Claude Code's cheap background requests (quick
# classification, title generation, etc), same comma-separated form.
# Optional — if unset, BIG_MODEL is used for everything.
SMALL_MODEL=gpt-4o-mini


# --- Provider 2 (used when provider 1 fails) ----------------------------
# Delete this block if you only want one provider. Model names are per
# provider, since the same model is often named differently on each.
PROVIDER_NAME_2=openrouter fallback
OPENAI_BASE_URL_2=https://openrouter.ai/api/v1
OPENAI_API_KEY_2=sk-or-...
BIG_MODEL_2=openai/gpt-4o
SMALL_MODEL_2=openai/gpt-4o-mini

# --- Provider 3, 4, ... -------------------------------------------------
# Same pattern, bumping the number. A local model makes a good last resort:
# OPENAI_BASE_URL_3=http://localhost:11434/v1
# OPENAI_API_KEY_3=
# BIG_MODEL_3=llama3

# Port this proxy listens on.
PORT=3000


# Set to off to stop streaming replies through token by token: opencc waits
# for the provider's whole reply, then hands it over as a single-shot stream.
# Useful when a backend's SSE is unreliable. Defaults to on.
# STREAMING=off
