# The OpenAI-compatible API you want Claude Code to actually use.
# Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1,
# http://localhost:11434/v1 (Ollama), etc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Model used for normal Claude Code requests (the Sonnet/Opus tier).
BIG_MODEL=gpt-4o

# Model used for Claude Code's cheap background requests (the Haiku tier:
# quick classification, title generation, etc). Optional — if unset,
# BIG_MODEL is used for everything.
SMALL_MODEL=gpt-4o-mini

# Port this proxy listens on.
PORT=3000
